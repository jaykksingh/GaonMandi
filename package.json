{
  "name": "gaonmandi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@gaonmandi/api --filter=@gaonmandi/worker --filter=@gaonmandi/admin",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck && pnpm typecheck:tooling",
    "typecheck:tooling": "tsc -p tooling/tsconfig.json --noEmit",
    "test": "pnpm test:vitest && pnpm --filter @gaonmandi/mobile test",
    "test:vitest": "vitest run",
    "test:rules": "node tooling/not-yet.mjs WP-02",
    "test:rls": "node tooling/not-yet.mjs WP-03",
    "db:migrate": "node tooling/not-yet.mjs WP-03",
    "db:seed": "node tooling/not-yet.mjs WP-03",
    "contracts:gen": "node tooling/not-yet.mjs WP-05",
    "e2e:mobile": "node tooling/not-yet.mjs WP-14",
    "e2e:admin": "node tooling/not-yet.mjs WP-16",
    "mobile:android": "pnpm --filter @gaonmandi/mobile android",
    "mobile:apk": "cd apps/mobile/android && ./gradlew assembleDebug assembleRelease",
    "mobile:apk-size": "node tooling/mobile/check-apk-size.mjs",
    "local:db": "bash tooling/local/setup-db.sh",
    "local:minio": "bash tooling/local/minio.sh",
    "doctor": "node tooling/doctor.mjs",
    "tokens:generate": "node tooling/tokens/generate.mjs",
    "i18n:native:generate": "node tooling/i18n/generate-native.mjs",
    "format:check": "prettier --check .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.29.0",
    "fast-check": "^4.3.0",
    "globals": "^16.2.0",
    "pg": "^8.16.3",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
