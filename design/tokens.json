      "urgent": { "$type": "color", "$value": "#A3261B" },
      "urgentSoft": { "$type": "color", "$value": "#F9DEDA" }
    },
    "bid": {
      "highest": { "$type": "color", "$value": "#5A2E8C" },
      "soft": { "$type": "color", "$value": "#ECE3F6" }
    },
    "danger": {
      "default": { "$type": "color", "$value": "#A3261B" },
      "soft": { "$type": "color", "$value": "#F9DEDA" }
    }
  },
  "font": {
    "family": {
      "devanagari": { "$type": "fontFamily", "$value": ["Noto Sans Devanagari", "sans-serif"] },
      "latin": { "$type": "fontFamily", "$value": ["Noto Sans", "sans-serif"] }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "32px" },
      "title": { "$type": "dimension", "$value": "22px" },
      "heading": { "$type": "dimension", "$value": "18px" },
      "body": { "$type": "dimension", "$value": "16px" },
      "label": { "$type": "dimension", "$value": "14px" },
      "caption": { "$type": "dimension", "$value": "13px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "lineHeight": {
      "devanagari": { "$type": "number", "$value": 1.4 },
      "latin": { "$type": "number", "$value": 1.3 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
