      "soft": { "$type": "color", "$value": "#DCEFE2" },
      "onBrand": { "$type": "color", "$value": "#FFFFFF" }
    },
    "fish": {
      "default": { "$type": "color", "$value": "#1C5D8C" },
      "soft": { "$type": "color", "$value": "#DCEAF5" }
    },
    "crop": {
      "default": { "$type": "color", "$value": "#8A5A12" },
      "soft": { "$type": "color", "$value": "#F6E8CF" }
    },
    "fresh": {
