# GaonMandi environment template. Copy to .env.local and fill in local values.
# Placeholders only: never put real keys in this file.

# Local ports
API_PORT=4000
ADMIN_PORT=3200

# Database (local native Postgres 16 + PostGIS)
DATABASE_URL=postgres://gm_api:gm_local_only@localhost:5432/gaonmandi
DATABASE_MIGRATOR_URL=postgres://gm_migrator:gm_local_only@localhost:5432/gaonmandi
# Local superuser connection used to create and drop throwaway test databases.
TEST_DATABASE_ADMIN_URL=postgres://postgres:gm_local_only@localhost:5432/postgres

# Object storage (local MinIO; Supabase Storage S3 endpoint in the cloud)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=gm_local
S3_SECRET_ACCESS_KEY=gm_local_only
S3_BUCKET_MEDIA=media

# Auth
JWT_SIGNING_KEY=          # local: any 32+ random bytes, base64
PHONE_HASH_KEY=           # HMAC key for phone hashes, base64
OTP_DEV_ECHO=true         # local only: return the code in the API response instead of sending SMS

# SMS (MSG91, DLT-registered template). Leave empty locally to use the fake adapter.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=

# Push (Firebase Cloud Messaging). Leave empty locally to use the fake adapter.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# WhatsApp Business Cloud API. Leave empty locally to use the fake adapter.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NEW_LISTING=

# Admin console
ADMIN_SESSION_SECRET=     # local: any 32+ random bytes, base64
